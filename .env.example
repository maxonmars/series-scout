# Образец настроек Series Scout. Скопируйте в .env и заполните.
# Пустое значение считается незаданным. Переменные окружения процесса имеют приоритет над .env.

# Telegram: токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram: числовой id владельца; бот будет отвечать только ему.
TELEGRAM_OWNER_ID=

# DeepSeek: API-ключ из личного кабинета platform.deepseek.com.
DEEPSEEK_API_KEY=
# Имя модели DeepSeek.
LLM_MODEL=deepseek-flash

# TMDB: API Read Access Token (длинный JWT, не короткий API Key) из настроек API на themoviedb.org.
TMDB_READ_ACCESS_TOKEN=

# Google Calendar: id отдельного календаря для премьер, вида …@group.calendar.google.com.
GOOGLE_CALENDAR_ID=
# Google Calendar: путь к JSON-ключу сервисного аккаунта, например ./secrets/google-service-account.json.
# Каталог secrets/ исключён из Git.
GOOGLE_APPLICATION_CREDENTIALS=

# Каталог локальных данных; относительный путь считается от рабочего каталога.
DATA_DIR=./.local
# Часовой пояс IANA для дат премьер и напоминаний.
APP_TIME_ZONE=Asia/Novosibirsk
